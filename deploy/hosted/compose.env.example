GEN2SPRING_ROOTLESS_DOCKER_UID=1000
GEN2SPRING_ROOTLESS_DOCKER_GID=1000
GEN2SPRING_ROOTLESS_DOCKER_SOCKET=/run/user/1000/docker.sock
GEN2SPRING_HOST_SECRET_DIR=/srv/gen2spring/secrets
GEN2SPRING_HOST_WORKSPACE_ROOT=/srv/gen2spring/workspaces
GEN2SPRING_HOST_SANDBOX_SECRET_ROOT=/run/user/1000/gen2spring-secrets
GEN2SPRING_TLS_DIR=/srv/gen2spring/tls
GEN2SPRING_SECRET_DIR=/srv/gen2spring/secrets
GEN2SPRING_GENERATION_IMAGE=localhost/gen2spring-generation-runner@sha256:replace-with-built-digest
GEN2SPRING_IMPORT_IMAGE=localhost/gen2spring-import-runner@sha256:replace-with-built-digest
GEN2SPRING_OIDC_CLIENT_ID=replace-with-public-client-id
GEN2SPRING_OIDC_ISSUER_URI=https://identity.example.com/realms/gen2spring
GEN2SPRING_RUNTIME_BASE_URI=https://gen2spring.example.com
GEN2SPRING_CREDENTIAL_ACTIVE_KEY_ID=key-2
GEN2SPRING_HTTPS_BIND=127.0.0.1
GEN2SPRING_WORKER_ID=worker-1
# Managed Runtime requires 32-byte credential-key-active and credential-key-retired
# files, a private runtime token pepper, plus a dedicated
# provider-egress client/server mTLS certificate pair under GEN2SPRING_SECRET_DIR.
